#!/usr/bin/env bash
# pre-push —— 「改 state/sync/activity 后四剧本必跑」的机械形态（档案 §57）。
#
# 判据实锤：AGENTS.md 的「必跑」是纯纪律——2026-11-16 读面 best-effort 那轮改了
# state 读面却没跑剧本，chaos2 断言过时红了 8 天无人见（§56 复核抓回）。
# 纯文字裁决会复发（presence 两轮 / 单写源 / 绳牛四代同病），故上钩。
#
# 安装（每 clone 一次）：git config core.hooksPath .githooks
# 逻辑：本次推送触及 state/workspace/index/model/sync 面 → go vet + S7 四剧本；
#       否则只 go vet。任一失败即中止推送。
# 绕过：git push --no-verify——留给确有理由的人；绕过本身会留在你的自觉里。
set -uo pipefail
cd "$(git rev-parse --show-toplevel)" || exit 1
z40=0000000000000000000000000000000000000000
empty_tree=4b825dc642cb6eb9a060e54bf8d69288fbee4904
scripts_list="scripts/dogfood-s7.sh scripts/dogfood-s7-chaos.sh scripts/dogfood-s7-chaos2.sh scripts/dogfood-s7-design.sh"

any=0; touched=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue   # 删分支不检
  any=1
  if [ "$remote_sha" = "$z40" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || echo "$empty_tree")
  else
    base="$remote_sha"
  fi
  if git diff --name-only "$base" "$local_sha" -- internal/state internal/workspace internal/index internal/model cmd/ousheng/main.go 2>/dev/null | grep -q .; then
    touched=1
  fi
done

[ "$any" = "1" ] || exit 0
echo "[pre-push] go vet ./..."
go vet ./... || { echo "[pre-push] FATAL: go vet 未过——推送中止"; exit 1; }
[ "$touched" = "1" ] || exit 0

for s in $scripts_list; do
  log="/tmp/ousheng-prepush-$(basename "$s").log"
  echo "[pre-push] $s"
  if ! bash "$s" >"$log" 2>&1; then
    echo "[pre-push] FATAL: $s 失败（日志 ${log}）——改 state/sync/activity 后四剧本必跑（AGENTS.md）"
    exit 1
  fi
done
echo "[pre-push] 四剧本全绿"
